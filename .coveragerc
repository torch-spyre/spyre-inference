# Driven by the Makefile (`make test COVERAGE=1`, `make coverage`). Must be
# present wherever the combine runs; [paths] is what merges data across runners.
[run]
# source_pkgs (not source) so coverage resolves spyre_inference as an installed
# package wherever it lives -- works for both an editable checkout and a
# site-packages install, not just a local folder relative to the run dir.
source_pkgs = spyre_inference
parallel = true
# Plugin code runs in vLLM's spawned worker/EngineCore processes, not pytest;
# without this coverage sees only the driver. coverage's shipped a1_coverage.pth
# hook (triggered by COVERAGE_PROCESS_START) starts coverage in interpreters not
# launched via the multiprocessing module.
concurrency = multiprocessing,thread
# vLLM SIGTERMs workers; flush on SIGTERM. SIGKILL'd workers (timeout/OOM) are
# still lost, so the aggregate is a lower bound for those paths.
sigterm = true

[paths]
# Alias each runner's absolute source paths onto the local checkout so combine
# merges them and report finds the sources.
source =
    spyre_inference
    */spyre_inference
    */site-packages/spyre_inference

[report]
show_missing = true
skip_covered = false
# setuptools_scm-generated, gitignored: it's measured on the test runner but
# absent from the aggregate runner's checkout, so report would otherwise fail
# with "No source for code" when it tries to resolve the file.
omit = */spyre_inference/_version.py
