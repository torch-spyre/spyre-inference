      pooler_d: "row gather via index_select · L2 normalize via rsqrt · reads only real rows, using the per-request offsets\neager today · compiling the pooler is its own work item, not a warmup" {
        style.fill: "#1565c0"
        style.stroke: "#1565c0"
        style.font-color: "#D6E4F7"
        style.font-size: 13
        style.bold: false
        width: 790
        height: 56
      }
    }

    mean_dep: "MEAN copies packed [T, H] as fp16 and reduces with MeanPool on the host.\nDestagger of a device fp32 sum (to(fp16) then convert) is garbage (torch-spyre#2971). index_add_ (#3507) would let the reduce stay on the card." {
      style.fill: "#FFF8E1"
      style.stroke: "#F9A825"
      style.font-color: "#5d4037"
      style.font-size: 13
      style.bold: false
      style.border-radius: 6
      width: 920
    }

    output: "Pooled vectors → host" {
