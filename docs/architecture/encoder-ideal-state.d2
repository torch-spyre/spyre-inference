      tables: "Row tables and masks, built once per step and carried on the attention metadata" {
        style.fill: "#E3E9FD"
        style.stroke: "#0d47a1"
        style.font-color: "#0A0F25"
        style.font-size: 14
        style.bold: true
        style.border-radius: 6
        label.near: top-center
        grid-rows: 1
        grid-columns: 1
        grid-gap: 0
        width: 870

        tables_d: "one int32 row table and one [group, 1, 1, extent] mask per plan · derived from the per-request lengths, so identical for every layer" {
          style.fill: "#E3E9FD"
          style.stroke: "#E3E9FD"
          style.font-color: "#37474f"
          style.font-size: 12
          style.bold: false
          width: 740
          height: 38
        }
      }

      fused: "Fused kernel: gather → SDPA → store, one compiled graph" {
        style.fill: "#E3E9FD"
        style.stroke: "#0d47a1"
        style.font-color: "#0A0F25"
        style.font-size: 14
        style.bold: true
        style.border-radius: 6
        label.near: top-center
        grid-rows: 1
        grid-columns: 1
        grid-gap: 0
        width: 870

        fused_d: "index_select the plan's rows into [group * extent, H, D] · batched SDPA · index_copy_ the result back\nkeyed on (buffer_rows, group, extent) · pad lanes clamp to the sequence's last real row, so no zero row is needed" {
          style.fill: "#E3E9FD"
          style.stroke: "#E3E9FD"
          style.font-color: "#37474f"
          style.font-size: 12
          style.bold: false
          width: 740
          height: 56
        }
      }

      barriers: "tables on the metadata instead of rebuilt per layer · one launch per plan per layer, where the three-stage split cost three" {
        style.fill: "#1565c0"
        style.stroke: "#1565c0"
        style.font-color: "#D6E4F7"
        style.font-size: 13
        style.bold: false
        style.border-radius: 6
        width: 870
