      style.bold: true
      style.border-radius: 8
      label.near: top-center
      grid-rows: 1
      grid-columns: 1
      grid-gap: 0
      width: 920

      output_d: "only [num_reqs, hidden] crosses the boundary · padded rows are discarded, never pooled" {
        style.fill: "#37474f"
        style.stroke: "#37474f"
        style.font-color: "#CFD2DD"
        style.font-size: 13
        style.bold: false
        width: 790
        height: 38
      }
    }

    sched -> dispatch -> body -> attention -> pooler -> mean_dep -> output
  }

