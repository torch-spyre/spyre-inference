# Encoder / embedding models on Spyre: target state
#
# Source for encoder-ideal-state.svg.
#
# Layout: explicit nested grids, as in system-overview.d2, so placement comes from
# nesting rather than the auto-layout engine. Regions mirror the SVG:
#
#   upper : serving path (left)  |  sidebar of four panels (right)
#   lower : dense vs flash strategies, then the summary note beside the legend
#
# Conventions worth knowing before editing:
#
#  * Alignment follows the SVG. Plain quoted labels are CENTRED, so every coloured
#    box and inner box uses one, with `\n` for line breaks. `|md ... |` blocks are
#    LEFT-aligned, so only the prose panels use markdown: the invariants, the
#    compile-mode note, the A/B strategy panels and the summary. D2 offers no
#    alignment control, so the label type is the alignment choice.
#  * A plain label is a single weight, so a centred box cannot have a bold first
#    line on its own. The workaround: put the bold title in a container's label
#    (with `label.near: top-center`) and the lighter detail in a child whose
#    `stroke` equals its `fill`, so the child's own border is invisible and the
#    two read as one box. `body` uses this pattern.
#  * Do NOT use markdown backticks. D2 renders inline code with its own pale
#    background, which on a dark or blue fill leaves white text on a light chip.
#    Identifiers are written plain; underscores inside a word are safe, because
#    CommonMark does not treat intraword `_` as emphasis.
#  * With `label.near: top-left` a container's label is drawn inside its fill, so a
#    coloured container needs a light font-color. Without it the label lands on the
#    parent's background and a white label becomes invisible.
#  * dagre cannot set width/height on a container. A container that needs a fixed
#    width must therefore declare a grid (`grid-rows`/`grid-columns`), which hands
#    its layout to D2 instead of dagre. layer_stack and boundary use a 1x1 grid for
#    exactly this reason.
#  * Markdown reflows text: a single newline does not break a line. Lines that must
#    break end with TWO TRAILING SPACES (a hard break), which keeps them in one
#    paragraph and so avoids the paragraph margin. A blank line is used only where a
#    real gap is wanted. Do not let an editor strip that trailing whitespace, or the
#    prose blocks will reflow and widen.
#  * A markdown-labelled shape gets neither a border nor a width from D2. Panels that
#    need either put the border, the width and the bold title on a wrapping container
#    and keep the prose in a blended child. dense / flash / simplifies do this.
#  * Bullets use `·` rather than list syntax, to match the SVG.
#
# Render:
#   d2 --pad 50 docs/architecture/encoder-ideal-state.d2 /tmp/encoder-ideal-state.svg

grid-rows: 2
grid-columns: 1
grid-gap: 50

upper: " " {
  style.fill: "#FFFFFF"
  style.stroke: "#FFFFFF"
  grid-rows: 1
  grid-columns: 2
  grid-gap: 40

  serving: "Per-step serving path" {
    style.fill: "#EEF1F8"
    style.stroke: "#CFD2DD"
    style.font-color: "#212121"
    style.font-size: 20
    style.bold: true
    style.border-radius: 10
    label.near: top-left
    direction: down

    sched: "vLLM Scheduler, used as-is" {
      style.fill: "#37474f"
      style.stroke: "#263238"
      style.font-color: "#ffffff"
      style.font-size: 15
      style.bold: true
      style.border-radius: 8
      label.near: top-center
      grid-rows: 1
      grid-columns: 1
      grid-gap: 0
      width: 920

      sched_d: "batches S requests carrying T tokens in total · chunked prefill off\nnever subclassed, its output never mutated" {
        style.fill: "#37474f"
        style.stroke: "#37474f"
        style.font-color: "#CFD2DD"
        style.font-size: 13
        style.bold: false
        width: 790
        height: 56
      }
    }

    dispatch: "Token-count bucket dispatch" {
      style.fill: "#1565c0"
      style.stroke: "#0d47a1"
      style.font-color: "#ffffff"
      style.font-size: 15
      style.bold: true
      style.border-radius: 8
      label.near: top-center
      grid-rows: 1
      grid-columns: 1
      grid-gap: 0
      width: 920

      dispatch_d: "round T up to the next compiled bucket, giving T_padded\nupstream this hook pads to a captured CUDA graph; here to a compiled shape\npad rows zeroed · also cuts torch-spyre per-op recompiles" {
        style.fill: "#1565c0"
        style.stroke: "#1565c0"
        style.font-color: "#D6E4F7"
        style.font-size: 13
        style.bold: false
        width: 790
        height: 74
      }
    }

    body: "Compiled model body: one graph per token bucket  (fullgraph, dynamic=False)" {
      style.fill: "#1565c0"
      style.stroke: "#0d47a1"
      style.font-color: "#ffffff"
      style.font-size: 16
      style.bold: true
      style.border-radius: 8
      label.near: top-center
      width: 920
      grid-rows: 3
      grid-columns: 1
      grid-gap: 10

      body_note: "sees only the flat token list [T_padded, hidden], with no request boundaries\nall layers share op shapes, so cost scales with distinct T, not with depth" {
        style.fill: "#1565c0"
        style.stroke: "#1565c0"
        style.font-color: "#D6E4F7"
        style.font-size: 13
        style.bold: false
        style.border-radius: 6
        width: 870
      }

      layer_stack: "Embeddings → N × [ Q · K · V projections (un-fused) · output projection · FFN ×2 · LayerNorm ×2 ]" {
        style.fill: "#E3E9FD"
        style.stroke: "#0d47a1"
        style.font-color: "#0A0F25"
        style.font-size: 14
        style.bold: true
        style.border-radius: 6
        label.near: top-center
        grid-rows: 1
        grid-columns: 1
        grid-gap: 0
        width: 870

        layer_stack_d: "N = 24 for multilingual-e5-large · 6 matrix multiplies per layer, 5 of them outside attention" {
          style.fill: "#E3E9FD"
          style.stroke: "#E3E9FD"
          style.font-color: "#37474f"
          style.font-size: 12
          style.bold: false
          width: 740
          height: 38
        }
      }

      boundary: "torch.ops.vllm.unified_attention_with_output  ·  opaque boundary" {
        style.fill: "#E3E9FD"
        style.stroke: "#0d47a1"
        style.stroke-dash: 4
        style.font-color: "#0A0F25"
        style.font-size: 14
