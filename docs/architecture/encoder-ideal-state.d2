        grid-rows: 1
        grid-columns: 1
        grid-gap: 0
        width: 870

        boundary_d: "Dynamo does not trace inside. Selected by the platform's opaque_attention_op() → True,\nwhich TorchSpyrePlatform inherits from CpuPlatform" {
          style.fill: "#E3E9FD"
          style.stroke: "#E3E9FD"
          style.font-color: "#5c6bc0"
