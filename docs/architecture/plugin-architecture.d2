direction: down

bookends: "Model Bookends" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  EMB: "SpyreVocabParallelEmbedding\n(on-device gather; TP shard tables\nbuilt on CPU at load, applied on-device)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LM: "SpyreParallelLMHead\nx @ Wᵀ on Spyre; logits stay on\nSpyre for TP all_gather\n(TP≥1 vocab shard; pad to 64×32)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LP: "SpyreLogitsProcessor\nD2H logits → CPU after head /\nTP all_gather (host-side sampling)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }

  LM -> LP: "logits"
}

granite: "Granite Decoder Layer (× N)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  N1: "RMSNorm (upstream native)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  QKV: "SpyreQKVParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\nq,k,v split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ROPE: "SpyreRotaryEmbedding\n(rotation cache primed pre-compile;\nindex_select + 2×2 rotation in-graph)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ATTN: "SpyreHeadMajorAttentionImpl\n(default; SpyreAttentionImpl for\ntoken_major) Spyre kernels;\nhost-side metadata & loop" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  O_PROJ: "SpyreRowParallelLinear — o_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  N2: "RMSNorm (upstream native)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  GATE: "SpyreMergedColumnParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\ngate,up split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ACT: "SiluAndMul (upstream)\nsilu(gate)·up in the Spyre graph\n(mlp_pad stick-aligns the split)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  DOWN: "SpyreRowParallelLinear — down_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  N1 -> QKV -> ROPE -> ATTN -> O_PROJ
  O_PROJ -> N2: "+residual"
  N2 -> GATE -> ACT -> DOWN
}

attn_detail: "Decoder Attention Pipeline" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  S1: "Build metadata & masks (host)\nread query_start_loc / seq_lens, pad query &\nKV blocks to buckets, build index tables +\nadditive mask on CPU → copy to Spyre" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  S2: "Write new K/V into the paged cache\n(compiled index_copy_ through a\nslot-major view) on Spyre" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  S3: "Page attention (compiled): one kernel\nper sequence, or one batched kernel\nfor 4+ decode seqs; gather rows on-device →\nQ @ Kᵀ·scale → soft-cap? → +mask →\nonline softmax → @V" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  S4: "Write each result into the Spyre\noutput buffer (device→device copy)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  S1 -> S2 -> S3 -> S4
}

encoder_attn: "SpyreEncoderAttentionImpl (no KV cache)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  E1: "Plan once per step (host): rectangle if\nthe batch fits one (runner lays it out as\na [B·L] grid), else ragged groups of equal\nextent; masks + row tables → one convert" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  E2: "Rectangle: one F.sdpa over the grid\n(traced into the block graph when\ncompiled with a stick-aligned head size)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  E3: "Ragged: per group, one fused\ngather → F.sdpa → index_copy_ kernel\n(host round-trip only for sub-stick\nhead dims, e.g. MiniLM D=32)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  E1 -> E2: "fits a rectangle"
  E1 -> E3: "too wide"
}

bookends.EMB -> granite: "hidden states"
granite -> bookends.LM: "final hidden"
granite.ATTN -> attn_detail: "detail" {style.stroke-dash: 3}
granite.ATTN -> encoder_attn: "encoder-only models\nuse this impl instead" {style.stroke-dash: 3}

legend: " " {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  L1: "Spyre device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  L3: "Mixed: Spyre compute + host-side metadata" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
}
