direction: down

bookends: "Model Bookends" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  EMB: "SpyreVocabParallelEmbedding\n(on-device gather; TP shard tables\nbuilt on CPU at load, applied on-device)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LM: "SpyreParallelLMHead\nx @ Wᵀ on Spyre; logits stay on\nSpyre for TP all_gather\n(TP≥1 vocab shard; pad to 64×32)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LP: "SpyreLogitsProcessor\nD2H logits → CPU after head /\nTP all_gather (host-side sampling)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }

  LM -> LP: "logits"
}

granite: "Granite Decoder Layer (× N)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  N1: "SpyreRMSNorm" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  QKV: "SpyreQKVParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\nq,k,v split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ROPE: "SpyreRotaryEmbedding\n(4D rotation cache primed pre-compile;\nindex_select + 2×2 rotation in-graph)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ATTN: "SpyreAttentionImpl\n(Spyre kernels;\nhost-side metadata & loop)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  O_PROJ: "SpyreRowParallelLinear — o_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  N2: "SpyreRMSNorm" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  GATE: "SpyreMergedColumnParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\ngate,up split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ACT: "SiluAndMul (upstream)\nsilu(gate)·up in the Spyre graph\n(mlp_pad stick-aligns the split)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  DOWN: "SpyreRowParallelLinear — down_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  N1 -> QKV -> ROPE -> ATTN -> O_PROJ
  O_PROJ -> N2: "+residual"
  N2 -> GATE -> ACT -> DOWN
}

attn_detail: "SpyreAttentionImpl Pipeline" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  S1: "Build metadata & masks (host)\nread query_start_loc / seq_lens, pad query &\nKV blocks to buckets, build index tables +\nadditive mask on CPU → copy to Spyre" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  S2: "Write new K/V into the paged cache\n(compiled index_copy_ through a\nslot-major view) on Spyre" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  S3: "Per-sequence page attention (compiled):\ngather query rows on-device →\nQ @ Kᵀ·scale → soft-cap? → +mask →\nonline softmax → @V" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  S4: "Write each result into the Spyre\noutput buffer (device→device copy)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  S1 -> S2 -> S3 -> S4
}

encoder_attn: "SpyreEncoderAttentionImpl (no KV cache)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  E1: "Ragged→dense pack: build pack indices +\nadditive mask on CPU, then scatter Q/K/V into\nthe dense [B,H,L,Dp] batch on Spyre\n(compiled index_copy_; L-pad structural)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  E2: "Batched attention on Spyre\nfused F.sdpa (B=1, no live pad) OR\ncompiled QK-matmul + on-device mask-add\n+ compiled P·V (additive-mask path)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  E3: "Unpack (index_select) + write-back\n(output.copy_) on Spyre\n(CPU round-trip only for non-stick head\ndims, e.g. MiniLM D=32)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  E1 -> E2 -> E3
}

bookends.EMB -> granite: "hidden states"
granite -> bookends.LM: "final hidden"
granite.ATTN -> attn_detail: "detail" {style.stroke-dash: 3}
granite.ATTN -> encoder_attn: "encoder-only models\nuse this impl instead" {style.stroke-dash: 3}

legend: " " {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  L1: "Spyre device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  L3: "Mixed: Spyre compute + host-side metadata" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
}
