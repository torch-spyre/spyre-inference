direction: down
classes: {
  control: {style: {fill: "#37474f"; stroke: "#263238"; font-color: "#ffffff"}}
  plugin: {style: {fill: "#2e7d32"; stroke: "#1b5e20"; font-color: "#ffffff"; bold: true}}
  device: {style: {fill: "#1565c0"; stroke: "#0d47a1"; font-color: "#ffffff"}}
  container: {style: {fill: "#e0e0e0"; stroke: "#9e9e9e"; font-color: "#212121"}}
}

control: "Control plane — target persistent lifecycle" {
  class: container
  delegator: "Node-local delegator\nCreatePool / OpenPool / DestroyPool" {class: control}
}

clients: "Data plane — compatible serving instances" {
  class: container
  a: "Instance A\nShared manager + page worker" {class: plugin}
  b: "Instance B\nShared manager + page worker" {class: plugin}
}

pair: "Named pair per selected cache group — retained at startup" {
  class: container
  lifecycle: "Generation-checked attachment\nAttachPool / DetachPool only for serving\nPublished entries survive last detach" {class: control}
  directory: "Host-resident shared metadata\nComponent key → slot + generation\nClaim / publish / pin / evict" {class: control}
  data: "SharedPool data slots\nHost memory OR secondary memory\nNo automatic tiering" {class: device; shape: cylinder}
  lifecycle -> directory: "protect pair identity"
  directory -> data: "all components valid + pinned before a hit"
}

control.delegator -> pair.lifecycle: "provision / resolve / explicit destroy"
clients.a -> pair.lifecycle: "attach / detach"
clients.b -> pair.lifecycle: "attach / detach"
clients.a -> pair.directory: "claim → copy → publish pages" {style.stroke-dash: 3}
clients.b -> pair.directory: "lookup → pin → recheck → copy" {style.stroke-dash: 3}
clients.a <-> pair.data: "byte-exact page DMA"
clients.b <-> pair.data: "byte-exact page DMA"

scope: "Target architecture: M2 demonstrates host sharing; M3 separately demonstrates\nsecondary-memory transport. Combining them and persistent lifecycle remain work." {
  class: container
}
pair -> scope: "implementation status" {style.stroke-dash: 3}
